# Chat-completions endpoint the AI assistant posts to: a JSON
# {stream, messages} request in, an SSE stream back. The playground holds no
# inference credential of its own — that endpoint owns the backend, its keys
# and its quotas. Unset disables the assistant.
PLAYGROUND_AI_URL=

# Optional: override the default per-run timeout (milliseconds).
# RUN_TIMEOUT_MS=15000

# Optional server-side Binplorer personal key for the top 200 BNB Smart Chain holders.
# With no key, the public endpoint provides up to 100 holders.
# BINPLORER_API_KEY=

# Optional fallback for DingTalk notifications. The local web settings take precedence.
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=...
# Set the signing secret only if the robot has signing enabled.
# DINGTALK_WEBHOOK_SECRET=

# Optional database path. Use the same path for the web server and the monitor process.
# PLAYGROUND_MONITOR_DB=.cache/market-monitor/monitor.sqlite

# ── 下单（交易策略 → 统一执行层）──────────────────────────────
# 账号可在「交易策略 → 账号设置」保存，下列账号变量用作后备配置。
# 开新仓前请在对应的币安 USDⓈ-M 账户启用双向持仓。
# off（默认，不下单）| demo（币安模拟盘 Demo Trading）| live（币安实盘）
# PLAYGROUND_TRADING_MODE=demo
# 模拟盘 API Key：在 https://demo.binance.com 登录后创建，与实盘 Key 分开。
# BINANCE_DEMO_API_KEY=
# BINANCE_DEMO_API_SECRET=
# 实盘 API Key：只开「合约交易」权限，不要开提现，建议绑定 IP 白名单。
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# 实盘必须再设置这一行，否则拒绝启动下单：
# PLAYGROUND_LIVE_TRADING_CONFIRM=YES_I_UNDERSTAND_REAL_MONEY
# 风控上限（可选）：单笔金额默认模拟盘 200 / 实盘 20 USDT，同时持仓 3 笔，杠杆 ≤ 5 倍。
# PLAYGROUND_MAX_ORDER_NOTIONAL=20
# PLAYGROUND_MAX_OPEN_TRADES=3
# PLAYGROUND_MAX_LEVERAGE=5
